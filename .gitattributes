# Checked-in fixtures are compared byte for byte against generated text, and a
# Windows checkout with autocrlf would rewrite them to CRLF. Pin them to LF so
# the comparison is about content.
*.txt text eol=lf
*.livemd text eol=lf

# Everything else: normalise in the repository and check out as LF. Claude's
# plugin directory refuses a line-ending rule without eol=lf on its own line
# (it cannot know which bytes a checkout gives), and this repository is LF
# everywhere anyway.
* text=auto eol=lf
